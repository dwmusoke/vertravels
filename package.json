{
  "name": "vertravels",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.2.4",
  "description": "VerTravels - Modern Travel Booking Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^1.11.1"
  }
}