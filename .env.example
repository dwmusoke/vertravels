# ========================================
# VERTRAVELS ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ========================================

# ========================================
# SUPABASE CONFIGURATION
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ========================================
# APP CONFIGURATION
# ========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_VERCEL_ENV=development

# ========================================
# PAYMENT GATEWAYS - STRIPE
# ========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================================
# PAYMENT GATEWAYS - FLUTTERWAVE
# ========================================
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret

# ========================================
# PAYMENT GATEWAYS - PAYPAL
# ========================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_webhook_id

# ========================================
# THIRD-PARTY INTEGRATIONS - AMADEUS
# ========================================
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
AMADEUS_ENVIRONMENT=test

# ========================================
# THIRD-PARTY INTEGRATIONS - NDC
# ========================================
NDC_API_KEY=your_ndc_api_key
NDC_API_URL=https://api.ndc.test/v1

# ========================================
# THIRD-PARTY INTEGRATIONS - TRAVELPORT
# ========================================
TRAVELPORT_USERNAME=your_travelport_username
TRAVELPORT_PASSWORD=your_travelport_password
TRAVELPORT_BRANCH=your_branch_code
TRAVELPORT_ENVIRONMENT=test

# ========================================
# THIRD-PARTY INTEGRATIONS - KIWI
# ========================================
KIWI_API_KEY=your_kiwi_api_key
KIWI_ENVIRONMENT=test

# ========================================
# EMAIL SERVICE - SENDGRID
# ========================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@vertravels.com
SENDGRID_FROM_NAME=VerTravels

# ========================================
# ANALYTICS
# ========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ========================================
# ERROR MONITORING - SENTRY
# ========================================
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn
SENTRY_ORG=your_org
SENTRY_PROJECT=vertravels

# ========================================
# SECURITY
# ========================================
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=3600000

# ========================================
# UPLOADS & STORAGE
# ========================================
NEXT_PUBLIC_UPLOAD_URL=/uploads
UPLOAD_MAX_SIZE=10485760

# ========================================
# CACHE
# ========================================
CACHE_TTL=3600
ISR_REVALIDATE=300
